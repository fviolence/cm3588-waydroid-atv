From 4e41f7bf6f916d7258c2fe39d42780ad8a50bdee Mon Sep 17 00:00:00 2001
From: Dick Valentine <asetium@gmail.com>
Date: Fri, 16 Oct 2026 23:09:50 +0200
Subject: [PATCH] surfaceflinger: request linear Mali framebuffer targets

---
 .../DisplayHardware/FramebufferSurface.cpp               | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp b/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
index 709dd9b7d01cc50cffefbb3526fa7989ba9c5a2a..f01ad21b2ba1fe81c1c354e87fcc461639a5036c 100644
--- a/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
+++ b/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
@@ -70,9 +70,16 @@ FramebufferSurface::FramebufferSurface(HWComposer& hwc, PhysicalDisplayId displa
 void FramebufferSurface::initializeConsumer() {
     mName = "FramebufferSurface";
     mConsumer->setConsumerName(mName);
+
+    // Mali Bifrost: request an uncompressed display target.
+    // The allocator probe confirmed bit 29 produces DRM_FORMAT_MOD_LINEAR.
+    constexpr uint64_t kMaliGrallocUsageNoAfbc = 1ULL << 29;
+
     mConsumer->setConsumerUsageBits(GRALLOC_USAGE_HW_FB |
                                        GRALLOC_USAGE_HW_RENDER |
-                                       GRALLOC_USAGE_HW_COMPOSER);
+                                       GRALLOC_USAGE_HW_COMPOSER |
+                                       kMaliGrallocUsageNoAfbc);
+
     mConsumer->setDefaultBufferSize(mLimitedSize.width, mLimitedSize.height);
     mConsumer->setMaxAcquiredBufferCount(
             SurfaceFlinger::maxFrameBufferAcquiredBuffers - 1);
-- 
