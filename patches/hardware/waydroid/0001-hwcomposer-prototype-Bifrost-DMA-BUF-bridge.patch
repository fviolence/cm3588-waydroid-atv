+// Experimental Bifrost DMA-BUF bridge. Gralloc4 plane layouts do not identify
+// which native-handle FD backs each plane. Restrict this initial implementation
+// to precisely one DMA-BUF FD and one plane. Unsupported layouts fail closed.
+// Import is OFF by default: persist.waydroid.bifrost_dmabuf=1 opts in.
+// The first stage prints mapper metadata without sending anything to Weston.
+namespace {
+    void log_bifrost_probe(const char* reason, buffer_handle_t handle,
+                           uint32_t width, uint32_t height, uint32_t fourcc,
+                           uint64_t modifier, size_t planes, int64_t stride,
+                           int64_t offset) {
+        static std::atomic<uint32_t> attempts {0};
+        const auto n = attempts.fetch_add(1, std::memory_order_relaxed);
+        if (n < 16 || (n % 128) == 0) {
+            ALOGW("BIFROST_DMABUF_PROBE: %s handle=%p fds=%d %ux%u fourcc=0x%08x "
+                  "modifier=0x%016llx planes=%zu stride=%lld offset=%lld attempt=%u",
+                  reason, handle, handle ? handle->numFds : -1, width, height,
+                  fourcc, static_cast<unsigned long long>(modifier), planes,
+                  static_cast<long long>(stride), static_cast<long long>(offset), n);
+        }
+    }
+
+    buffer_metadata get_buffer_metadata_bifrost(display *, hwc_layer_1_t *layer, size_t) {
+        if (!layer->handle) return {};
+        auto& mapper = android::GraphicBufferMapper::get();
+        uint64_t width = 0, height = 0;
+        android::ui::PixelFormat requested_format {};
+        const int ew = mapper.getWidth(layer->handle, &width);
+        const int eh = mapper.getHeight(layer->handle, &height);
+        const int ef = mapper.getPixelFormatRequested(layer->handle, &requested_format);
+        if (ew || eh || ef || !width || !height || width > INT32_MAX ||
+            height > INT32_MAX || static_cast<int32_t>(requested_format) <= 0) {
+            log_bifrost_probe("invalid basic gralloc metadata", layer->handle,
+                              static_cast<uint32_t>(width), static_cast<uint32_t>(height),
+                              0, 0, 0, 0, 0);
+            return {};
+        }
+        // For DMA-BUF, pixel stride is not used to describe its planes. The
+        // actual byte strides are read from Gralloc4 PlaneLayout below.
+        return {static_cast<uint32_t>(height), static_cast<uint32_t>(width),
+                0, static_cast<uint32_t>(requested_format)};
+    }
+
+    std::unique_ptr<buffer> create_buffer_bifrost_dmabuf(
+            display *display, const buffer_metadata& metadata, buffer_handle_t handle) {
+        if (!handle || !display->dmabuf) return nullptr;
+        auto& mapper = android::GraphicBufferMapper::get();
+        uint32_t fourcc = 0;
+        uint64_t modifier = DRM_FORMAT_MOD_INVALID;
+        std::vector<android::ui::PlaneLayout> planes;
+        const int ef = mapper.getPixelFormatFourCC(handle, &fourcc);
+        const int em = mapper.getPixelFormatModifier(handle, &modifier);
+        const int ep = mapper.getPlaneLayouts(handle, &planes);
+        const int64_t stride = planes.empty() ? 0 : planes.front().strideInBytes;
+        const int64_t offset = planes.empty() ? 0 : planes.front().offsetInBytes;
+        if (ef || em || ep) {
+            log_bifrost_probe("mapper metadata query failed", handle, metadata.width,
+                              metadata.height, fourcc, modifier, planes.size(), stride, offset);
+            return nullptr;
+        }
+        if (handle->numFds != 1 || planes.size() != 1 || !fourcc ||
+            stride <= 0 || stride > INT32_MAX || offset < 0 || offset > INT32_MAX) {
+            log_bifrost_probe("unsupported fd/plane/stride layout", handle, metadata.width,
+                              metadata.height, fourcc, modifier, planes.size(), stride, offset);
+            return nullptr;
+        }
+        // Weston must explicitly advertise the FourCC + modifier combination.
+        const auto it = display->modifiers.find(fourcc);
+        if (!display->formats.count(fourcc) || it == display->modifiers.end() ||
+            std::find(it->second.begin(), it->second.end(), modifier) == it->second.end()) {
+            log_bifrost_probe("not advertised by Weston", handle, metadata.width,
+                              metadata.height, fourcc, modifier, planes.size(), stride, offset);
+            return nullptr;
+        }
+        if (!property_get_bool("persist.waydroid.bifrost_dmabuf", false)) {
+            log_bifrost_probe("ready (import DISABLED)", handle, metadata.width,
+                              metadata.height, fourcc, modifier, planes.size(), stride, offset);
+            return nullptr;
+        }
+        log_bifrost_probe("attempting import (EXPERIMENTAL)", handle, metadata.width,
+                          metadata.height, fourcc, modifier, planes.size(), stride, offset);
+        return create_dmabuf_wl_buffer(display, metadata, handle->data[0],
+                                       static_cast<int>(fourcc), static_cast<int>(stride),
+                                       static_cast<int>(offset), modifier, handle);
+    }
+}
