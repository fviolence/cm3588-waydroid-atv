From 0be51fe9d0a04aa3afda834b3464694fa22723e7 Mon Sep 17 00:00:00 2001
From: Dick Valentine <asetium@gmail.com>
Date: Fri, 16 Oct 2026 22:42:33 +0200
Subject: [PATCH] minigbm: skip Mesa GBM wrapper when Mesa backend is disabled

---
 gbm_mesa_driver/Android.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/gbm_mesa_driver/Android.mk b/gbm_mesa_driver/Android.mk
index 9c74a7ab0cf58e2ad81aceeb476915f991fa88f1..09793a65e6b1287b48ee7c662b2ef1ef28c6e640 100644
--- a/gbm_mesa_driver/Android.mk
+++ b/gbm_mesa_driver/Android.mk
@@ -18,6 +18,10 @@
 
 LOCAL_PATH := $(call my-dir)
 
+# The wrapper requires Mesa's libgbm_mesa. Do not define it when
+# the Mesa GBM backend is disabled.
+ifneq ($(filter true,$(BOARD_MESA3D_BUILD_LIBGBM)),)
+
 include $(CLEAR_VARS)
 
 LOCAL_SRC_FILES := \
@@ -34,3 +38,5 @@ LOCAL_MODULE_TAGS := optional
 LOCAL_VENDOR_MODULE := true
 
 include $(BUILD_SHARED_LIBRARY)
+
+endif # BOARD_MESA3D_BUILD_LIBGBM
-- 
2.56.0

